{
  "name": "scheffershen/video-saas-webmcp-demo",
  "description": "A Symfony video workspace with native browser WebMCP tools and an agent skill.",
  "license": "MIT",
  "type": "project",
  "require": {
    "php": ">=8.4",
    "ext-pdo": "*",
    "ext-pdo_sqlite": "*",
    "symfony/framework-bundle": "7.4.*",
    "symfony/console": "7.4.*",
    "symfony/form": "7.4.*",
    "symfony/validator": "7.4.*",
    "symfony/security-csrf": "7.4.*",
    "symfony/twig-bundle": "7.4.*",
    "symfony/process": "7.4.*",
    "symfony/mime": "7.4.*",
    "doctrine/dbal": "^4.3"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.0",
    "symfony/browser-kit": "7.4.*",
    "symfony/css-selector": "7.4.*"
  },
  "autoload": {"psr-4": {"App\\": "src/"}},
  "autoload-dev": {"psr-4": {"App\\Tests\\": "tests/"}},
  "config": {"sort-packages": true, "allow-plugins": false}
}
