{% extends 'base.html.twig' %}
{% block body %}<div class="page-heading"><div><p class="eyebrow">Your isolated demo session</p><h1>Video content</h1><p>Create a draft with the form or your AI agent.</p></div><a class="primary" href="/content/new">Add video content</a></div>{% if drafts %}<div class="draft-list">{% for draft in drafts %}<a class="draft-row" href="{{ draft.url }}"><div><span class="badge">Draft</span><h2>{{ draft.title }}</h2><p>{{ draft.summary }}</p></div><span>{{ draft.duration|number_format(1) }}s →</span></a>{% endfor %}</div>{% else %}<section class="empty"><h2>Your first video starts here.</h2><p>Select the sample video and save a draft to see it in your workspace.</p><a href="/content/new">Open the content form →</a></section>{% endif %}{% endblock %}
