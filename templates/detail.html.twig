{% extends 'base.html.twig' %}
{% block body %}<div class="page-heading"><div><p class="eyebrow">Persisted in your workspace</p><h1>{{ draft.title }}</h1><p>{{ draft.summary }}</p></div><span class="badge">Draft · Unpublished</span></div>
<section class="panel detail"><video controls preload="metadata" src="/media/{{ draft.asset_id }}" {% if draft.cover_id|default('') %}poster="/attachments/{{ draft.cover_id }}"{% endif %}>
{% for lang in ['en','fr','de','it','es'] %}{% set id=attribute(draft,'subtitle_' ~ lang)|default('') %}{% if id %}<track kind="subtitles" src="/attachments/{{ id }}" srclang="{{ lang }}" label="{{ lang|upper }}" {{ lang == draft.language ? 'default' : '' }}>{% endif %}{% endfor %}</video>
<dl><div><dt>Saved draft ID</dt><dd id="draft-id">{{ draft.id }}</dd></div><div><dt>Video asset</dt><dd>{{ draft.asset_id }}</dd></div><div><dt>Duration</dt><dd>{{ draft.duration|number_format(1) }} seconds</dd></div><div><dt>Category / language</dt><dd>{{ draft.category }} / {{ draft.language }}</dd></div><div><dt>Content date</dt><dd>{{ draft.content_date }}</dd></div><div><dt>Cover</dt><dd>{% if draft.cover_id|default('') %}<a href="/attachments/{{ draft.cover_id }}">View uploaded cover</a>{% else %}No cover attached{% endif %}</dd></div><div><dt>Subtitle files</dt><dd>{% for lang in ['en','fr','de','it','es'] %}{% set id=attribute(draft,'subtitle_' ~ lang)|default('') %}{% if id %}<a href="/attachments/{{ id }}">{{ lang|upper }} VTT</a> {% endif %}{% endfor %}</dd></div><div><dt>Publication</dt><dd>Not published</dd></div></dl><a class="primary" href="/content/new">Add another video</a><a class="text-link" href="/workspace">View all drafts</a></section>{% endblock %}
